# ==============================================================================
# rag-telemetry-audit-daemon Environment Configuration
# Copy this file to .env for local development or integration testing.
# Never commit .env or real credentials to version control.
# ==============================================================================

# --- Go Runtime Memory Tuning (1Gi request / 2Gi limit pod defaults) ---------
GOMEMLIMIT=1800MiB
GOGC=80

# --- HTTP Admin, Probes & Metrics Server --------------------------------------
HTTP_ADDR=:8080
# Optional separate bind address for /metrics (empty = served on HTTP_ADDR)
METRICS_ADDR=:9090
# Comma-separated tenant IDs allowed as Prometheus metric labels (optional)
METRICS_TENANT_ALLOWLIST=

# --- Admin / Reconciliation Auth (/v1/reconcile/gaps) -------------------------
# HMAC-SHA256 secret for Bearer JWT validation (set in production/local dev)
AUTH_JWT_SECRET=
AUTH_JWT_AUDIENCE=rag-telemetry-audit-daemon
# Optional static admin Bearer token (leave empty unless needed)
STATIC_ADMIN_TOKEN=
RECONCILE_RATE_LIMIT_PER_MIN=30

# --- Local NVMe mmap_wal Spillover --------------------------------------------
WAL_DIR=./tmp/wal
# 5 GiB upper bound (5368709120 bytes)
WAL_MAX_BYTES=5368709120

# --- Kafka Consumer Group (Compliance Plane) ----------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=audit-compliance-records
KAFKA_GROUP_ID=rag-telemetry-audit-daemon

# --- ClickHouse Hot Tier (Native TCP RowBinary) -------------------------------
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TLS=false
CLICKHOUSE_TLS_INSECURE_SKIP_VERIFY=false

# --- AWS S3 WORM Cold Tier (Object Lock Compliance Mode) ----------------------
S3_BUCKET=rag-audit-worm-vault
S3_REGION=us-east-1
# Optional S3 endpoint override (e.g. http://localhost:4566 for LocalStack)
S3_ENDPOINT=
S3_KMS_KEY_ID=alias/rag-audit-worm-cmk
# Set true for LocalStack/MinIO path-style addressing
S3_USE_PATH_STYLE=false
S3_RETENTION_YEARS=7

# --- AWS SDK Credentials (optional; use IAM/IRSA in production) ---------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
